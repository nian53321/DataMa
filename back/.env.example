# 环境变量配置示例
FLASK_ENV=production
FLASK_APP=run.py

# MySQL 数据库（Docker 部署时 DB_HOST 用服务名 mysql，不要用 localhost）
DB_USER=root
DB_PASSWORD=请使用强密码
DB_HOST=mysql
DB_PORT=3306
DB_NAME=data_management

# JWT 密钥（生产环境必须更换为随机长字符串）
JWT_SECRET_KEY=请使用随机生成的强密钥

# CORS 白名单（前端经 nginx 反代同源访问 /api 时可不配；如需直连后端 5000 端口则配具体域名）
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Celery / Redis（Docker 部署时用服务名 redis）
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# 日志级别
LOG_LEVEL=INFO

# Gunicorn
GUNICORN_WORKERS=4
